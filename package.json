{
  "name": "mactavish-designs",
  "version": "1.0.0",
  "description": "MacTavish Designs portfolio",
  "scripts": {
    "build:widget": "esbuild _dev-widget-src.jsx --bundle --outfile=dev-widget-bundle.js --platform=browser --format=iife --define:process.env.NODE_ENV='\"development\"'",
    "sass": "sass --watch New.scss:output.css --style compressed",
    "serve": "live-server --watch=*.html,output.css,resources",
    "start": "npm-run-all build:widget --parallel sass serve"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "uuid": ">=14.0.0"
  },
  "devDependencies": {
    "agentation": "^3.0.2",
    "esbuild": "^0.28.1",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.77.8"
  }
}
